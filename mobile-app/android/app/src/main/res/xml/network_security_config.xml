<?xml version="1.0" encoding="utf-8"?>
<!-- LAN Versus talks to the other phone over plain ws:// on the local network (there is no
     certificate for a phone's Wi-Fi address). Everything on the internet (ads) still uses HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
